# Copie este arquivo para ".env" e preencha os valores reais (NUNCA suba o .env pro Git)

# String de conexão do Postgres. No Railway/Render isso é gerado automaticamente
# quando você adiciona um banco Postgres ao projeto.
DATABASE_URL=postgresql://usuario:senha@localhost:5432/sga_erp

# Chave secreta usada para assinar os tokens de login. Gere uma aleatória, por exemplo:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-uma-chave-aleatoria-longa

# Usados só na primeira migração, para criar o usuário Admin inicial
ADMIN_EMAIL_INICIAL=admin@norteagro.com
ADMIN_SENHA_INICIAL=troque-esta-senha-123

PORT=3000
